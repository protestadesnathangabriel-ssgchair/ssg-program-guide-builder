rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isAllowedEmail() {
      return signedIn() && request.auth.token.email in [
        'protestadesnathangabriel.ssggov@gmail.com',
        'protestadesnathangabriel.udmshs@gmail.com',
        'studentcouncil.caloocan@laverdad.edu.ph'
      ];
    }

    function isAdmin() {
      return isAllowedEmail() && request.auth.token.email in [
        'protestadesnathangabriel.ssggov@gmail.com',
        'protestadesnathangabriel.udmshs@gmail.com'
      ];
    }

    function canEdit() {
      return isAllowedEmail();
    }

    match /guides/{guideId} {
      allow read: if isAllowedEmail();

      allow create, update: if canEdit()
        && request.resource.data.keys().hasOnly([
          'title', 'content', 'type', 'updatedAt', 'updatedBy', 'schemaVersion'
        ])
        && request.resource.data.keys().hasAll([
          'title', 'content', 'type', 'updatedAt', 'updatedBy', 'schemaVersion'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 180
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 500000
        && request.resource.data.type is string
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.schemaVersion is int;

      allow delete: if isAdmin();
    }

    // Deny access to all collections not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
